{
  "schemaVersion": "1.1",
  "component": "prometheus",
  "role": "metrics-recording-slo-and-alert-evaluation-authority",
  "canonicalHostname": "prom.codestra.media",
  "exposure": "internal_private",
  "status": "CONFIG_PREPARED_NOT_DEPLOYED",
  "businessScope": [
    "codestra",
    "moneybee",
    "beyvra",
    "breero",
    "larim-a",
    "transportation",
    "booked4seasons",
    "social",
    "klyrow",
    "telnexa",
    "kyqra",
    "restaurant",
    "provisioning"
  ],
  "platformScope": [
    "caddy",
    "kong",
    "keycloak",
    "middleware",
    "odoo",
    "n8n",
    "vicidial",
    "postgresql",
    "redis",
    "openbao",
    "alloy",
    "otel-collector",
    "loki",
    "tempo",
    "grafana",
    "alertmanager"
  ],
  "requiredTargetLabels": [
    "codestra_business",
    "application",
    "service",
    "environment",
    "server",
    "region",
    "deployment"
  ],
  "forbiddenHighCardinalityLabels": [
    "tenant_id",
    "customer_id",
    "account_id",
    "user_id",
    "request_id",
    "correlation_id",
    "trace_id",
    "email",
    "phone",
    "message_id",
    "order_id",
    "workflow_id",
    "execution_id",
    "raw_url",
    "query_string",
    "db_statement",
    "container_id",
    "pod_uid"
  ],
  "requiredMetricFamilies": [
    "http_requests",
    "http_duration",
    "errors",
    "dependency_latency",
    "database_latency",
    "queue_depth",
    "worker_failures",
    "outbox_backlog",
    "inbox_backlog",
    "webhook_delivery",
    "webhook_retries",
    "authentication_failures",
    "authorization_denials",
    "idempotency_conflicts",
    "reconciliation_failures",
    "provider_health",
    "deployment_info",
    "capability_state"
  ],
  "exporters": ["node", "cadvisor", "postgres", "redis", "blackbox"],
  "features": {
    "recordingRules": true,
    "businessRollups": true,
    "sliAndSloEvaluation": true,
    "multiWindowBurnRates": true,
    "cardinalityBudgets": true,
    "alertmanagerIntegration": true,
    "deploymentCorrelation": true,
    "targetHealth": true,
    "capacityForecastInputs": true,
    "metricContractValidation": true,
    "pendingTargetActivationGates": true,
    "exemplarCompatibility": true,
    "remoteWriteReady": true,
    "selfMonitoring": true
  },
  "governance": {
    "prometheusIsMetricsAuthority": true,
    "alertmanagerOwnsRouting": true,
    "grafanaOwnsPresentation": true,
    "customerIdentifiersAsLabels": false,
    "nativeUiPublic": false,
    "businessTargetsDefaultToPending": true
  },
  "financialTradingBoundary": {
    "business": "beyvra",
    "rule": "Metrics expose safe aggregate availability, latency, errors, provider health, reconciliation and capability state only; no credentials, customer-level financial state, balances, positions, account IDs or order IDs are stored as labels."
  }
}
