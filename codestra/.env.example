# Image references are structurally assembled as repository@sha256:digest.
# Repository values must not contain tags or digests. Digest values must be exactly
# 64 lowercase hexadecimal characters. Run the mandatory preflight validator before
# every Compose render or deployment action.
PROMETHEUS_IMAGE_REPOSITORY=
PROMETHEUS_IMAGE_DIGEST=
POSTGRES_EXPORTER_IMAGE_REPOSITORY=
POSTGRES_EXPORTER_IMAGE_DIGEST=
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=40GB
PROMETHEUS_LISTEN_ADDRESS=127.0.0.1:9090
CODESTRA_OBSERVABILITY_NETWORK=codestra-observability
CODESTRA_DATABASE_NETWORK=codestra-database
POSTGRES_EXPORTER_URI_SECRET=codestra-postgres-exporter-uri
POSTGRES_EXPORTER_USER_SECRET=codestra-postgres-exporter-user
POSTGRES_EXPORTER_PASSWORD_SECRET=codestra-postgres-exporter-password
